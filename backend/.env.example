# Single environment switch:
# FALSE = localhost + val_demo
# TRUE  = zrok + valorant_intel
IS_PRODUCTION=FALSE

DB_HOST=localhost
DB_PORT=3306
# Leave blank to auto-select based on IS_PRODUCTION
DB_NAME=
DB_USER=root
DB_PASSWORD=

# OpenAI API Key (required for backend/api/ai_extract-OPENAI.php)
OPENAI_API_KEY=sk-...

# Optional: override the default model (gpt-4o)
# OPENAI_MODEL=gpt-4o

# Frontend URL used for password reset links
FRONTEND_BASE_URL=http://localhost:3002

# Comma-separated CORS allowlist (required for cookie sessions across origins)
# Example: CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://vl-trck.shares.zrok.io
CORS_ALLOWED_ORIGINS=http://localhost:3002

# Comma-separated emails that can access Superadmin module
SUPERADMIN_EMAILS=admin@example.com
