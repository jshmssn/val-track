# Optional frontend override. Leave unset to use relative /backend.
# REACT_APP_API_URL=http://localhost/val-track/backend
# REACT_APP_API_URL=https://vl-trck.shares.zrok.io/val-track/backend

# Optional dev proxy override. If unset, CRA proxy reads IS_PRODUCTION from backend/.env.
# BACKEND_PROXY_TARGET=http://localhost/val-track/backend
# BACKEND_PROXY_TARGET=https://vl-trck.shares.zrok.io/val-track/backend

# Team UUID
REACT_APP_TEAM_ID=aaaaaaaa-0000-0000-0000-000000000001

# Dev server port
PORT=3000

# Optional backend DB overrides (blank DB_NAME = auto from IS_PRODUCTION):
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=
# DB_USER=root
# DB_PASSWORD=
