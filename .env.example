# ── React Frontend ──────────────────────────────────────────
# API base used by frontend requests (zrok backend share).
# FOR LOCAL:
# REACT_APP_API_URL=https://vl-trck.shares.zrok.io/val-track/backend
# FOR LIVE:
REACT_APP_API_URL=https://vl-trck.shares.zrok.io/backend

# Optional (dev proxy mode only): local Apache backend target.
# BACKEND_PROXY_TARGET=http://localhost/val-track/backend
# FOR LOCAL:
# BACKEND_PROXY_TARGET=https://vl-trck.shares.zrok.io/val-track/backend
# FOR LIVE:
BACKEND_PROXY_TARGET=https://vl-trck.shares.zrok.io/backend

# our team's UUID from the database (from sample data or your own)
REACT_APP_TEAM_ID=aaaaaaaa-0000-0000-0000-000000000001

# Dev server port
PORT=3000
# ── PHP Backend (edit backend/config/database.php directly) ─
# DB_HOST=localhost
# DB_NAME=valorant_intel
# DB_USER=root
# DB_PASS=
