# ── React Frontend ──────────────────────────────────────────
# URL to your PHP backend folder.
# XAMPP/WAMP (put backend folder in htdocs/valorant-tracker/):
REACT_APP_API_URL=http://localhost/val-track/backend

# Your team's UUID from the database (from sample data or your own)
REACT_APP_TEAM_ID=aaaaaaaa-0000-0000-0000-000000000001

# Dev server port
PORT=3000

# ── PHP Backend (edit backend/config/database.php directly) ─
# DB_HOST=localhost
# DB_NAME=valorant_intel
# DB_USER=root
# DB_PASS=
