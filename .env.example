# ── React Frontend ──────────────────────────────────────────
# API base used by frontend requests.
# Use /backend when running react-scripts (dev server proxy).
REACT_APP_API_URL=/backend

# Dev proxy target (react-scripts only). Points to your XAMPP backend folder.
BACKEND_PROXY_TARGET=https://vl-trck.shares.zrok.io/backend

# our team's UUID from the database (from sample data or your own)
REACT_APP_TEAM_ID=aaaaaaaa-0000-0000-0000-000000000001

# Dev server port
PORT=3000
# ── PHP Backend (edit backend/config/database.php directly) ─
# DB_HOST=localhost
# DB_NAME=valorant_intel
# DB_USER=root
# DB_PASS=
